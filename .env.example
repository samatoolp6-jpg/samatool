PORT=3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/agro_surveillance?retryWrites=true&w=majority

# Authentification
JWT_SECRET=remplace-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# URL de ton site sur Render (ex. https://agro-surveillance.onrender.com), sans / à la fin
CLIENT_URL=

# Email (Brevo / Resend en SMTP). Si SMTP_HOST est vide, le lien est affiché dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SamaTool <no-reply@exemple.com>"

# Notifications Telegram : jeton du bot créé avec @BotFather (le webhook est enregistré automatiquement)
TELEGRAM_BOT_TOKEN=

# Une caméra est "hors ligne" sans signal depuis ce nombre de minutes
CAMERA_OFFLINE_MINUTES=3
